# Disposable, single-container PostgreSQL sandbox for free demo hosting.
# The normal Dockerfile.api + managed database remains the separate-service option.
FROM python:3.12-slim-bookworm AS python
FROM postgres:16-bookworm
COPY --from=python /usr/local /usr/local
RUN ldconfig
WORKDIR /app
COPY requirements-api.txt .
RUN python3 -m venv /opt/api-venv && /opt/api-venv/bin/pip install --no-cache-dir -r requirements-api.txt
COPY banking_api ./banking_api
COPY scripts/start-public-demo.sh ./start-public-demo.sh
RUN chmod 755 /app/start-public-demo.sh
ENV PATH="/opt/api-venv/bin:$PATH" BANKING_PUBLIC_DEMO=1 PORT=10000
USER postgres
EXPOSE 10000
ENTRYPOINT ["/app/start-public-demo.sh"]
